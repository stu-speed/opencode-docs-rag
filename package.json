{
  "name": "docs-rag",
  "version": "1.1.0",
  "private": true,
  "description": "OpenCode plugin: retrieval-augmented docs corpus (FAISS + SQLite FTS5 hybrid search over LM Studio embeddings)",

  "type": "module",
  "main": "dist/index.js",
  
  "opencode": {
    "skills": [
      {
        "name": "docs-rag",
        "description": "Command grammar for docs-rag plugin",
        "file": "./AGENTS.md"
      }
    ]
  },

  "files": [
    "dist",
    "python",
    "data",
    "index.js",
    "AGENTS.md",
    "config.json"
  ],

  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },

  "engines": {
    "node": ">=18"
  },

  "exports": {
    ".": "./dist/index.js"
  },


  "dependencies": {
    "@opencode/plugin": "^2.0.0"
  },

  "devDependencies": {
    "typescript": "^5.9",
    "@types/node": "^22"
  }
}
